# IT 140 Module Four Assignment


END hilow_game
START

DISPLAY "Welcome to the Higher/Lower Game!"

// Get valid lower and upper bounds
INPUT lowerBound
INPUT upperBound

WHILE lowerBound >= upperBound
    DISPLAY "Error: Lower bound must be less than upper bound."
    INPUT lowerBound
    INPUT upperBound
END WHILE

// Generate random number
SET secretNumber = RANDOM number between lowerBound and upperBound

// Get first guess
INPUT guess

WHILE guess < lowerBound OR guess > upperBound
    DISPLAY "Error: Guess must be between ", lowerBound, " and ", upperBound
    INPUT guess
END WHILE

// Continue game until correct guess
WHILE guess != secretNumber

    IF guess < secretNumber THEN
        DISPLAY "Too low! Try again."

    ELSE IF guess > secretNumber THEN
        DISPLAY "Too high! Try again."

    END IF

    INPUT guess

    WHILE guess < lowerBound OR guess > upperBound
        DISPLAY "Error: Guess must be between ", lowerBound, " and ", upperBound
        INPUT guess
    END WHILE

END WHILE

DISPLAY "Congratulations! You guessed the number!"

END


